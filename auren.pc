prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: auren
Description: Local LLM inference and embeddings via llama.cpp (standalone library)
Version: 1.5.0
Libs: -L${libdir} -laxil-auren -laxil -lxylem -lcorm -lsepal -lstele -ljson-c
Cflags: -I${includedir}
