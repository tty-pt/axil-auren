prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: axil-auren
Description: Local LLM inference and embeddings via llama.cpp (axil module)
Version: 1.4.0
Libs: -L${libdir} -laxil-auren -laxil -lxylem -lcorm -lsepal -lqsys -ljson-c
Cflags: -I${includedir}
